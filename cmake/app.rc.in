// Windows resources: app icon + version/file properties. Configured by CMake.
#include <windows.h>

IDI_ICON1 ICON "@ICON_ICO_PATH@"

1 VERSIONINFO
 FILEVERSION @APP_VERSION_RC@
 PRODUCTVERSION @APP_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Sawayama Solitaire"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "solitaire"
            VALUE "OriginalFilename", "solitaire.exe"
            VALUE "ProductName", "Sawayama Solitaire"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
            VALUE "LegalCopyright", "Released into the public domain (UNLICENSE)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
